# Keep the Docker build context small and secret-free.

# Secrets — never bake env files into an image.
.env
.env.*
*.env
deploy/.env.stack
deploy/env/*.env
deploy/.secrets

# Python build/runtime artefacts
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info

# Node / frontend artefacts (rebuilt inside Dockerfile.web)
**/node_modules
apps/research-desk/dist
apps/collaboration-server/dist
packages/editor-schema/dist

# VCS, local agent memory, IDE
.git
.gitignore
.cursor
.claude

# Tests, docs, examples — not needed in the runtime images
tests
docs
examples
logs
