# Optional migration-only environment for Compose and custom orchestrators.
# Copy this file to deploy/.env.migrate, keep it out of source control, and set
# INQTRIX_MIGRATION_ENV_FILE in the shared stack environment when using another
# path. API and worker services never load this file; runtime services keep
# using INQTRIX_DATABASE_URL from the stack env.

# Use a direct PostgreSQL connection, never PgBouncer transaction pooling.
# The dedicated login must satisfy the selected migration RLS mode documented
# in docs/deployment/database-migrations.md.
INQTRIX_MIGRATION_DATABASE_URL=postgresql+asyncpg://migration_user:CHANGE_ME@postgres.example.com:5432/inqtrix
