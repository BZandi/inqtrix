# Inqtrix collaboration image: builds the private Node WebSocket service from
# the frozen pnpm workspace, then runs only the bundled artifact as non-root.
#
# Build context is the repository root:
#   docker build -f deploy/docker/Dockerfile.collaboration -t inqtrix-collaboration .

# --- Stage 1: install the frozen workspace and bundle the service ---
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo

# Keep workspace manifests and the patch set in the dependency layer. pnpm
# resolves the exact package-manager version from the root package.json.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/research-desk/package.json apps/research-desk/package.json
COPY apps/collaboration-server/package.json apps/collaboration-server/package.json
COPY packages/editor-schema/package.json packages/editor-schema/package.json
COPY patches ./patches
RUN corepack pnpm install --frozen-lockfile

COPY apps/collaboration-server ./apps/collaboration-server
COPY packages/editor-schema ./packages/editor-schema
RUN corepack pnpm --filter @inqtrix/collaboration-server build

# --- Stage 2: read-only-compatible, non-root runtime ---
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/apps/collaboration-server/dist ./dist

# Match the API image's OpenShift contract: vanilla runtimes use UID 1001,
# while restricted-v2 may substitute an arbitrary UID in group 0. The process
# writes nowhere, but group-readable/executable application files keep the
# image valid under either identity.
RUN chgrp -R 0 /app && chmod -R g=u /app
USER 1001
EXPOSE 1234
CMD ["node", "--enable-source-maps", "dist/main.cjs"]
