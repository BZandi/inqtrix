# Inqtrix web image: builds the React Research Desk and serves it via nginx,
# reverse-proxying /api, /v1 and /health to the api service (single origin).
#
# Build context is the repository root:
#   docker build -f deploy/docker/Dockerfile.web -t inqtrix-web .

# --- Stage 1: build the SPA bundle with the pinned pnpm via corepack ---
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo

# Workspace manifests + lockfile first for layer caching. corepack resolves
# the exact pnpm version from package.json "packageManager".
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/research-desk/package.json apps/research-desk/
RUN corepack pnpm install --frozen-lockfile

# Source, then build. ui:build -> tsc -b && vite build -> apps/research-desk/dist.
COPY apps/research-desk ./apps/research-desk
COPY scripts/run_research_desk_ui.mjs ./scripts/run_research_desk_ui.mjs
RUN corepack pnpm run ui:build

# --- Stage 2: nginx serving the static bundle + API reverse-proxy ---
# nginx-unprivileged runs as a non-root user, listens on 8080 and keeps its PID
# file and temp paths under /tmp, so it satisfies OpenShift restricted-v2 and a
# read-only root filesystem out of the box (plain nginx writes /var/run and
# /var/cache as root and would be rejected). The config ships as a template:
# the base image entrypoint runs envsubst over /etc/nginx/templates/* and
# substitutes only defined env vars, so ${INQTRIX_API_UPSTREAM} is resolved per
# deployment while nginx runtime vars stay intact. Default keeps compose working.
FROM nginxinc/nginx-unprivileged:1.27-alpine
ENV INQTRIX_API_UPSTREAM=api:5100
# nginx upload body-size cap. Default sits just above the API's
# INQTRIX_MAX_FILE_BYTES default (100 MiB) plus multipart envelope, so the API
# stays the authoritative limit (its 413 carries a message). Raise both
# together when a deployment allows larger files.
ENV INQTRIX_CLIENT_MAX_BODY_SIZE=110m
COPY --from=build /repo/apps/research-desk/dist /usr/share/nginx/html
COPY deploy/nginx/inqtrix.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 8080
