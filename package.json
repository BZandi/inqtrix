{
  "name": "inqtrix",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0",
    "pnpm": ">=11.1.1"
  },
  "overrides": {
    "@tiptap/core": "3.27.1",
    "@tiptap/extension-blockquote": "3.27.1",
    "@tiptap/extension-bold": "3.27.1",
    "@tiptap/extension-bubble-menu": "3.27.1",
    "@tiptap/extension-bullet-list": "3.27.1",
    "@tiptap/extension-code": "3.27.1",
    "@tiptap/extension-code-block": "3.27.1",
    "@tiptap/extension-collaboration": "3.27.1",
    "@tiptap/extension-collaboration-caret": "3.27.1",
    "@tiptap/extension-document": "3.27.1",
    "@tiptap/extension-drag-handle": "3.27.1",
    "@tiptap/extension-drag-handle-react": "3.27.1",
    "@tiptap/extension-dropcursor": "3.27.1",
    "@tiptap/extension-floating-menu": "3.27.1",
    "@tiptap/extension-gapcursor": "3.27.1",
    "@tiptap/extension-hard-break": "3.27.1",
    "@tiptap/extension-heading": "3.27.1",
    "@tiptap/extension-highlight": "3.27.1",
    "@tiptap/extension-horizontal-rule": "3.27.1",
    "@tiptap/extension-italic": "3.27.1",
    "@tiptap/extension-link": "3.27.1",
    "@tiptap/extension-list": "3.27.1",
    "@tiptap/extension-list-item": "3.27.1",
    "@tiptap/extension-list-keymap": "3.27.1",
    "@tiptap/extension-mathematics": "3.27.1",
    "@tiptap/extension-node-range": "3.27.1",
    "@tiptap/extension-ordered-list": "3.27.1",
    "@tiptap/extension-paragraph": "3.27.1",
    "@tiptap/extension-strike": "3.27.1",
    "@tiptap/extension-table": "3.27.1",
    "@tiptap/extension-table-cell": "3.27.1",
    "@tiptap/extension-table-header": "3.27.1",
    "@tiptap/extension-table-row": "3.27.1",
    "@tiptap/extension-task-item": "3.27.1",
    "@tiptap/extension-task-list": "3.27.1",
    "@tiptap/extension-text": "3.27.1",
    "@tiptap/extension-text-align": "3.27.1",
    "@tiptap/extension-underline": "3.27.1",
    "@tiptap/extensions": "3.27.1",
    "@tiptap/markdown": "3.27.1",
    "@tiptap/pm": "3.27.1",
    "@tiptap/react": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "@tiptap/suggestion": "3.27.1",
    "@tiptap/y-tiptap": "3.0.6",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.0",
    "prosemirror-view": "1.42.1",
    "yjs": "13.6.31"
  },
  "scripts": {
    "e2e:dev": "INQTRIX_E2E_MODE=dev playwright test",
    "e2e:list": "INQTRIX_E2E_MODE=dev playwright test --list",
    "e2e:release": "pnpm run e2e:typecheck && pnpm run e2e:tooling:test && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types e2e/release-command.ts",
    "e2e:test": "pnpm run e2e:dev",
    "e2e:tooling:test": "INQTRIX_E2E_MODE=dev node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types e2e/browser-observer.test.ts e2e/config.test.ts e2e/control.test.ts e2e/layout.test.ts e2e/protocol-session.test.ts e2e/release-command.test.ts e2e/release-reporter.test.ts e2e/transport-fingerprint.test.ts",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "load:collaboration": "pnpm run load:collaboration:dev",
    "load:collaboration:check": "node --check tests/load/collaboration-load.mjs && node --check tests/load/collaboration-load-lib.mjs",
    "load:collaboration:dev": "node tests/load/collaboration-load.mjs --mode dev",
    "load:collaboration:release": "pnpm run load:collaboration:check && pnpm run load:collaboration:test && node tests/load/collaboration-load.mjs --mode release",
    "load:collaboration:test": "node --test tests/load/collaboration-load.test.mjs",
    "ui:dev": "node scripts/run_research_desk_ui.mjs dev",
    "ui:build": "node scripts/run_research_desk_ui.mjs build",
    "ui:lint": "node scripts/run_research_desk_ui.mjs lint",
    "ui:test": "node scripts/run_research_desk_ui.mjs test",
    "ui:typecheck": "node scripts/run_research_desk_ui.mjs typecheck",
    "ui:preview": "node scripts/run_research_desk_ui.mjs preview",
    "ui:prod": "node scripts/run_research_desk_ui.mjs build && node scripts/run_research_desk_ui.mjs preview"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.12.4",
    "typescript": "6.0.3",
    "ws": "8.21.0",
    "yjs": "13.6.31"
  }
}
